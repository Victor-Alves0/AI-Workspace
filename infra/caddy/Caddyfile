# HTTPS do AI Workspace — um endereço só para tudo.
#
#   https://<host>/       → front (web:3000)
#   https://<host>/api/*  → API  (server:8000)
#
# Mesma ORIGEM para os dois: o navegador não trata as chamadas como cross-site, então
# não há CORS no caminho e o cookie de sessão vale no endereço inteiro (era a origem
# dos 401 ao alternar entre IP da LAN e IP da VPN).
#
# O certificado vem do arquivo tls-{CADDY_MODE}.caddy:
#   CADDY_MODE=local  (padrão) → CA interna do Caddy, emitindo SOB DEMANDA para o
#     nome/IP que chegar. É o que faz `https://192.168.1.10` e `https://10.10.0.10`
#     funcionarem sem ninguém listar endereço nenhum. O navegador avisa até você
#     confiar na CA (docs/https.md).
#   CADDY_MODE=public         → certificado público automático (Let's Encrypt), para
#     um DOMÍNIO em CADDY_SITE (ex.: CADDY_SITE=app.seudominio.com) com as portas
#     80/443 alcançáveis da internet.
{
	# sem API de administração exposta numa instalação self-hosted
	admin off
}

{$CADDY_SITE::443} {
	import tls-{$CADDY_MODE:local}.caddy
	encode zstd gzip

	# a API vem antes: /api/chats → server:8000/chats
	handle_path /api/* {
		reverse_proxy server:8000 {
			# streaming (SSE do chat) precisa sair na hora, sem buffer
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
