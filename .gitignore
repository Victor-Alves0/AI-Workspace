# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
out/
.turbo/
dist/

# Env / secrets
.env
.env.local
*.local
# segredos por ARQUIVO (APP_SECRET_FILE/DATABASE_URL_FILE montados em /run/secrets)
secrets/
# chaves privadas: assinatura do updater (aiworkspace.key) e code signing (.pfx/.p12).
# O .cer (certificado PÚBLICO) fica versionado de propósito — é o que o usuário importa
# para confiar na assinatura do instalador.
*.key
*.pfx
*.p12
*.pem

# Tauri
desktop/src-tauri/target/
# motor embarcado montado pelo CI (Postgres + backend + frontend); nunca versionar
desktop/src-tauri/engine/
# saidas dos builders do motor e do pacote de codigo (auto-update)
desktop/engine/out/
desktop/engine/out-app/

# OS
.DS_Store
Thumbs.db

# Data
pgdata/
*.sqlite
*.db

# override local do compose (ex.: expor a porta do Postgres) — escolha por-máquina
docker-compose.override.yml
