# =========================================================================
# AI Workspace — configuração de ambiente
# Copie para `.env` (`cp .env.example .env`) e ajuste. NUNCA versione o `.env`.
#
# Como ler este arquivo:
#   - linhas ATIVAS (sem #) = o mínimo que você provavelmente quer conferir.
#   - linhas COMENTADAS (#VAR=...) = opcionais/avançadas, mostrando o DEFAULT.
#     Descomente só se for mudar. A maioria dos segredos (chaves de API dos
#     provedores, tokens de bot/OAuth) NÃO fica aqui — cada usuário salva os seus
#     na interface, cifrados no banco.
# =========================================================================


# =========================================================================
# 1) SEGURANÇA / AMBIENTE
# =========================================================================
# development | production. Em production o servidor RECUSA iniciar com um
# APP_SECRET inseguro/curto e o CORS aceita SÓ as origens exatas de WEB_ORIGIN
# (sem liberar a LAN automaticamente).
APP_ENV=development

# Segredo mestre (OBRIGATÓRIO trocar). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Assina os JWT e deriva a chave que CIFRA os segredos guardados no banco (chaves
# de API, tokens de bot/OAuth). Ele NÃO dá acesso ao banco (isso é a senha do
# Postgres). Trocá-lo à toa deixa os segredos ilegíveis (a app os trata como "não
# configurados") e desloga todo mundo.
#
# Precisa TROCAR a chave (vazou, etc.) SEM perder os segredos? Rode a rotação:
#   docker compose exec -e NEW_APP_SECRET=<nova> server python -m aiworkspace.secret_rotation --dry-run
#   docker compose exec -e NEW_APP_SECRET=<nova> server python -m aiworkspace.secret_rotation
# depois troque APP_SECRET para <nova> e reinicie (docker compose up -d server).
APP_SECRET=change-me-please-generate-a-long-random-value

# Permitir cadastro de novos usuários (o PRIMEIRO cadastrado vira admin).
# Depois de criar sua conta, considere ENABLE_SIGNUP=false para fechar o cadastro.
ENABLE_SIGNUP=true

# Sessão e rate-limit de login (avançado — os defaults servem).
#ACCESS_TOKEN_TTL_MIN=30
#REFRESH_TOKEN_TTL_DAYS=30
#LOGIN_MAX_ATTEMPTS=10
#LOGIN_WINDOW_SECONDS=300


# =========================================================================
# 2) BANCO DE DADOS
# =========================================================================
# Em produção, TROQUE a senha.
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=aiworkspace
POSTGRES_DB=aiworkspace
# O Postgres NÃO é publicado no host por padrão — a app o acessa pela rede interna
# do Docker (db:5432), então NUNCA colide com um Postgres que você já rode no PC.
# Para conectar um cliente externo (psql/DBeaver), copie
# docker-compose.override.yml.example → docker-compose.override.yml; a porta do
# host sai de DB_PORT. Sem isso, estas variáveis são ignoradas.
#DB_PORT=5432
#DB_BIND=127.0.0.1
# Montada a partir das vars acima dentro do compose. Só mexa para rodar o server
# FORA do Docker (aponte para o host/porta corretos do seu Postgres):
DATABASE_URL=postgresql+asyncpg://aiworkspace:aiworkspace@localhost:5432/aiworkspace


# =========================================================================
# 3) PROVEDOR DE MODELOS (OpenRouter)
# =========================================================================
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A chave do OpenRouter NÃO fica aqui: cada usuário salva a sua na UI (cifrada).
# Identificação enviada ao OpenRouter (aparece no dashboard dele):
#OPENROUTER_APP_NAME=AI Workspace
#OPENROUTER_APP_URL=https://ai-workspace.app


# =========================================================================
# 4) REDE / ACESSO — ajuste para acessar de outra máquina (LAN ou VPS)
# =========================================================================
# WEB_ORIGIN: origem(ns) do frontend, separadas por vírgula. É o que o CORS aceita.
#   - Local:   http://localhost:3000
#   - LAN/VPS: http://SEU_IP:3000        (ex.: http://192.168.1.199:3000)
#   - Domínio: https://seu-dominio.com
# Em APP_ENV=production SÓ estas origens exatas são aceitas — inclua a que você vai
# abrir no navegador. Pode listar várias: http://localhost:3000,http://SEU_IP:3000
WEB_ORIGIN=http://localhost:3000

# NEXT_PUBLIC_API_URL: URL do backend que o NAVEGADOR usa (embutida no build do web).
# DEIXE VAZIO para o front derivar a API do host da página (window.location:8000) —
# o mesmo build funciona por localhost, IP da LAN e VPS sem rebuild. Só preencha se
# o backend tiver domínio/porta próprios (ex.: https://api.seu-dominio.com).
NEXT_PUBLIC_API_URL=

# Bind/portas dos serviços publicados. Para expor numa VPS, deixe 0.0.0.0 e abra
# 3000 (web) e 8000 (server) no firewall; para restringir ao host, use 127.0.0.1.
# CONFLITO DE PORTA? Se o `up` falhar com "port is already allocated", troque a
# porta correspondente (ex.: WEB_PORT=3001 → http://localhost:3001).
#WEB_BIND=0.0.0.0
#WEB_PORT=3000
#SERVER_BIND=0.0.0.0
#SERVER_PORT=8000
# Portas dos serviços opt-in (só sobem com seus perfis):
#SEARXNG_PORT=8080      # perfil "search"
#EVOLUTION_PORT=8081    # perfil "whatsapp"
#KOKORO_PORT=8880       # perfil "voice"
#BROWSER_PORT=3009      # perfil "browser"
#BROWSER_BIND=127.0.0.1

# Atrás de um proxy reverso (nginx/traefik/Caddy) confiável? Ligue para o rate-limit
# usar o X-Forwarded-For. NÃO ligue sem proxy (o header é forjável).
#TRUST_PROXY=true


# =========================================================================
# 5) PESQUISA NA WEB
# =========================================================================
# provider: duckduckgo (padrão, sem chave) | searxng | tavily | brave
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5
# SearXNG self-hosted (metabuscador, sem chave): suba com
#   docker compose --profile search up -d searxng
# e defina WEB_SEARCH_PROVIDER=searxng. Dentro do compose o server já alcança o
# serviço em http://searxng:8080. Só mude a URL para um SearXNG externo (precisa do
# formato JSON habilitado). Chaves de Tavily/Brave são salvas por usuário (cifradas).
#SEARXNG_URL=http://searxng:8080


# =========================================================================
# 6) VOZ (TTS/STT)
# =========================================================================
# Endpoint compatível com OpenAI (/audio/speech, /audio/transcriptions). Padrão
# OpenAI; pode apontar p/ servidores locais (ex.: Kokoro via
# `docker compose --profile voice up -d`, openedai-speech, faster-whisper-server).
VOICE_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
STT_MODEL=whisper-1
# A chave do provedor de voz é salva por usuário (cifrada), não aqui.


# =========================================================================
# 7) NAVEGADOR HEADLESS (tool web.browser.use) — opt-in
# =========================================================================
# Chromium (browserless) que a IA dirige por CDP para sites com JS, logins e
# formulários de vários passos. Suba com:
#   docker compose --profile browser up -d
# ATENÇÃO: o browserless EXIGE um token — o MESMO valor precisa chegar ao container
# (TOKEN) e ao server (auth do CDP). Sem casar, a tool falha com 401 Unauthorized.
# Gere um: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Dentro do compose o BROWSER_WS_URL já resolve para ws://browser:3000 sozinho.
BROWSER_TOKEN=
#BROWSER_WS_URL=ws://browser:3000
#BROWSER_CONCURRENT=5
#BROWSER_TIMEOUT_MS=60000


# =========================================================================
# 8) CODESPACE (projetos de código + sandbox de execução)
# =========================================================================
# Onde os repositórios/worktrees dos projetos vivem no disco. No Docker é o volume
# `codespace_data` (deixe o default). Só mude para rodar FORA do Docker (o desktop
# já aponta para <DataDir>\codespace sozinho).
#CODESPACE_DATA_DIR=/data/codespace

# Sandbox de execução (tool code.exec.run: roda testes/build/lint do projeto).
# Baseline = subprocesso no host (Win/Linux/desktop, sem Docker). Para isolamento
# mais forte, aponte para um container runner (opt-in); vazio = roda no host.
#CODE_RUNNER_URL=
#CODE_RUNNER_TOKEN=
# Limites do exec no host e ciclo de vida dos worktrees (os defaults servem):
#CODE_EXEC_TIMEOUT_SECONDS=900
#CODE_EXEC_CPU_SECONDS=600
#CODE_EXEC_OUTPUT_BYTES=200000
#CODESPACE_WORKTREE_TTL_SECONDS=86400
#CODESPACE_MAX_WORKTREES_PER_USER=20


# =========================================================================
# 9) INTEGRAÇÕES — OAuth (redirect URIs)
# =========================================================================
# Client ID/Secret de cada integração são configurados na UI (Integrações, admin) e
# ficam cifrados no banco — NÃO aqui. Só o redirect_uri (não é segredo) fica no env,
# e precisa BATER com o cadastrado no console de cada provedor. Os defaults (localhost)
# funcionam local; troque para o domínio público do server em produção.
#GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
#GITHUB_REDIRECT_URI=http://localhost:8000/integrations/github/callback
#NOTION_REDIRECT_URI=http://localhost:8000/integrations/notion/callback
#SLACK_REDIRECT_URI=http://localhost:8000/integrations/slack/callback


# =========================================================================
# 10) WHATSAPP — opt-in
# =========================================================================
# Caminho NÃO oficial (QR Code) usa o serviço Evolution API do compose:
#   docker compose --profile whatsapp up -d
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(24))"
EVOLUTION_API_KEY=
# URL pública do server p/ webhooks do Cloud API OFICIAL da Meta (precisa ser https
# alcançável da internet — túnel/proxy). O Evolution usa a rede interna do compose.
#WHATSAPP_WEBHOOK_BASE=https://seu-dominio.com


# =========================================================================
# 11) TRANSCRIÇÃO DE VÍDEO (tool media.video.transcribe) — opcional
# =========================================================================
# YouTube & afins barram scraping repetido ("confirme que não é um bot", HTTP 429).
# `TRANSCRIBE_COOKIES_DIR` aponta p/ uma pasta de arquivos cookies.txt (Netscape) —
# cada arquivo é uma identidade e o pool rotaciona/coloca em cooldown quem tomar
# bloqueio. Vazio = só headers realistas, sem cookies. (Monte a pasta no compose.)
#TRANSCRIBE_COOKIES_DIR=
#TRANSCRIBE_COOKIE_COOLDOWN_SECONDS=1800


# =========================================================================
# 12) EXECUÇÃO DE CÓDIGO DO MODELO (code mode / run_code) — segurança
# =========================================================================
# Off-switch do "code mode": executa código GERADO PELO MODELO num sandbox de
# subprocesso (RCE por design). O sandbox limita CPU/memória/tempo, mas NÃO isola
# rede nem /proc. Deixe False em deploys multiusuário NÃO confiáveis.
#ALLOW_CODE_MODE=true
#SIFT_CODE_TIMEOUT_SECONDS=30
#SIFT_CODE_MEM_MB=512


# =========================================================================
# 13) OBSERVABILIDADE (traces/spans no Postgres) — avançado
# =========================================================================
# Rastro fim-a-fim (latência, tempo de banco, chamadas LLM). Os defaults servem.
# ATENÇÃO: OBS_CAPTURE_CONTENT=true grava o TEXTO de mensagens/prompts nos spans —
# é o dado sensível; só ligue para depurar.
#OBS_ENABLED=true
#OBS_SAMPLE_RATE=1.0
#OBS_RETENTION_DAYS=14
#OBS_MAX_TRACES=500000
#OBS_SLOW_MS=1500
#OBS_CAPTURE_CONTENT=false
