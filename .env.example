# =========================================================================
# AI Workspace — configuração de ambiente
# Copie para `.env` e ajuste. NUNCA versione o `.env` real.
# =========================================================================

# --- Segurança ---
# Ambiente: development | production. Em production o servidor RECUSA iniciar
# com um APP_SECRET inseguro/curto.
APP_ENV=development

# Segredo mestre da aplicação. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Usado para assinar JWT e derivar a chave de criptografia dos segredos.
APP_SECRET=change-me-please-generate-a-long-random-value

# Permitir cadastro de novos usuários (o primeiro vira admin).
ENABLE_SIGNUP=true

# --- Banco de dados ---
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=aiworkspace
POSTGRES_DB=aiworkspace
# DATABASE_URL é montada a partir das vars acima dentro do compose.
# Para rodar o server fora do Docker, aponte para o host correto:
DATABASE_URL=postgresql+asyncpg://aiworkspace:aiworkspace@localhost:5432/aiworkspace

# --- OpenRouter (provedor padrão) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A chave do OpenRouter NÃO fica aqui: cada usuário salva a sua (criptografada).

# --- Pesquisa na web ---
# provider: duckduckgo (padrão, sem chave) | searxng | tavily | brave
WEB_SEARCH_PROVIDER=duckduckgo
# Se usar SearXNG self-hosted, aponte a URL (precisa ter format=json habilitado):
SEARXNG_URL=http://localhost:8080
WEB_SEARCH_MAX_RESULTS=5
# Chaves de Tavily/Brave são salvas por usuário (criptografadas), não aqui.

# --- Voz (TTS/STT) ---
# Endpoint compatível com OpenAI. Padrão OpenAI; pode apontar p/ servidores locais
# (ex.: openedai-speech, faster-whisper-server).
VOICE_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
STT_MODEL=whisper-1
# A chave do provedor de voz é salva por usuário (criptografada), não aqui.

# --- CORS / origens ---
WEB_ORIGIN=http://localhost:3000

# --- Frontend ---
# URL pública do backend que o navegador usa.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Integração WhatsApp ---
# Caminho NÃO oficial (QR Code) usa o serviço Evolution API do compose (opt-in):
#   docker compose --profile whatsapp up -d
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(24))"
EVOLUTION_API_KEY=
# URL pública do server p/ webhooks do Cloud API oficial da Meta (precisa ser https
# alcançável da internet — túnel/proxy). O Evolution usa a rede interna do compose.
#WHATSAPP_WEBHOOK_BASE=https://seu-dominio.com
