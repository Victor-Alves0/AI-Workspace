# =========================================================================
# AI Workspace — configuração de ambiente
# Copie para `.env` (`cp .env.example .env`) e ajuste. NUNCA versione o `.env`.
# =========================================================================

# --- Segurança ---
# Ambiente: development | production. Em production o servidor RECUSA iniciar
# com um APP_SECRET inseguro/curto e o CORS aceita SÓ as origens exatas de
# WEB_ORIGIN (sem liberar a LAN automaticamente).
APP_ENV=development

# Segredo mestre da aplicação (OBRIGATÓRIO trocar). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Assina os JWT e deriva a chave de criptografia dos segredos guardados no banco.
# Se mudar depois, todas as sessões e segredos cifrados existentes ficam inválidos.
APP_SECRET=change-me-please-generate-a-long-random-value

# Permitir cadastro de novos usuários (o PRIMEIRO cadastrado vira admin).
# Depois de criar sua conta, considere ENABLE_SIGNUP=false para fechar o cadastro.
ENABLE_SIGNUP=true

# --- Banco de dados ---
# Em produção, TROQUE a senha. O Postgres é publicado só em 127.0.0.1 (não fica
# exposto na rede), mas ainda assim use uma senha forte.
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=aiworkspace
POSTGRES_DB=aiworkspace
# Montada a partir das vars acima dentro do compose. Só mexa para rodar o server
# FORA do Docker (aponte para o host/porta corretos do seu Postgres):
DATABASE_URL=postgresql+asyncpg://aiworkspace:aiworkspace@localhost:5432/aiworkspace

# --- OpenRouter (provedor padrão de modelos) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A chave do OpenRouter NÃO fica aqui: cada usuário salva a sua na UI (cifrada).

# --- Pesquisa na web ---
# provider: duckduckgo (padrão, sem chave) | searxng | tavily | brave
WEB_SEARCH_PROVIDER=duckduckgo
# SearXNG self-hosted (metabuscador, sem chave): suba com
#   docker compose --profile search up -d searxng
# e defina WEB_SEARCH_PROVIDER=searxng. Dentro do compose o server já alcança o
# serviço em http://searxng:8080 (não precisa mexer no SEARXNG_URL). Só mude a URL
# se apontar para um SearXNG externo (precisa ter o formato JSON habilitado).
#SEARXNG_URL=http://searxng:8080
WEB_SEARCH_MAX_RESULTS=5
# Chaves de Tavily/Brave são salvas por usuário (cifradas), não aqui.

# --- Voz (TTS/STT) ---
# Endpoint compatível com OpenAI. Padrão OpenAI; pode apontar p/ servidores locais
# (ex.: Kokoro via `docker compose --profile voice up -d`, openedai-speech, …).
VOICE_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
STT_MODEL=whisper-1
# A chave do provedor de voz é salva por usuário (cifrada), não aqui.

# =========================================================================
# REDE / ACESSO — ajuste isto para acessar de outra máquina (LAN ou VPS)
# =========================================================================
# WEB_ORIGIN: origem(ns) do frontend, separadas por vírgula. É o que o CORS aceita.
#   - Local:      http://localhost:3000
#   - LAN/VPS:    http://SEU_IP:3000        (ex.: http://192.168.1.199:3000)
#   - Domínio:    https://seu-dominio.com
# Em APP_ENV=production SÓ estas origens exatas são aceitas — inclua a que você
# vai usar no navegador. Pode listar várias: http://localhost:3000,http://SEU_IP:3000
WEB_ORIGIN=http://localhost:3000

# NEXT_PUBLIC_API_URL: URL do backend que o NAVEGADOR usa (embutida no build do web).
# DEIXE VAZIO para o front derivar a API do host da página (window.location:8000) —
# assim o mesmo build funciona por localhost, pelo IP da LAN e pela VPS sem rebuild.
# Só preencha se o backend tiver um domínio/porta próprios (ex.: https://api.seu-dominio.com).
NEXT_PUBLIC_API_URL=

# Bind/portas dos serviços publicados (padrão: todas as interfaces).
# Para expor numa VPS, deixe 0.0.0.0 e abra as portas 3000 (web) e 8000 (server)
# no firewall. Para restringir ao host, use 127.0.0.1.
#WEB_BIND=0.0.0.0
#WEB_PORT=3000
#SERVER_BIND=0.0.0.0
#SERVER_PORT=8000

# Atrás de um proxy reverso (nginx/traefik/Caddy) confiável? Ligue para o rate-limit
# usar o X-Forwarded-For. NÃO ligue sem proxy (o header é forjável).
#TRUST_PROXY=true

# --- Integração WhatsApp (opt-in) ---
# Caminho NÃO oficial (QR Code) usa o serviço Evolution API do compose:
#   docker compose --profile whatsapp up -d
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(24))"
EVOLUTION_API_KEY=
# URL pública do server p/ webhooks do Cloud API OFICIAL da Meta (precisa ser https
# alcançável da internet — túnel/proxy). O Evolution usa a rede interna do compose.
#WHATSAPP_WEBHOOK_BASE=https://seu-dominio.com
