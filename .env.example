# =========================================================================
# AI Workspace — .env
# Copie para `.env` (`cp .env.example .env`) e ajuste. NUNCA versione o `.env`.
#
# Aqui fica SÓ o que precisa de decisão humana. O resto do sistema se configura
# DENTRO do app:
#   - chaves de API (OpenRouter, Tavily/Brave, voz, bots, OAuth) → cada usuário
#     salva a sua na interface, cifrada no banco;
#   - cadastro de usuários, orçamento, modelos, ferramentas → painel do admin;
#   - ajustes finos (limites, timeouts, contexto, observabilidade) → têm default
#     e estão em docs/configuration.md.
# =========================================================================

# development | production. Em production o servidor RECUSA iniciar com um
# APP_SECRET fraco e o CORS deixa de aceitar HTTP.
APP_ENV=development

# OBRIGATÓRIO trocar. Assina os JWT e deriva a chave que CIFRA os segredos
# guardados no banco (chaves de API, tokens de bot/OAuth). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ele NÃO dá acesso ao banco (isso é a senha do Postgres). Trocá-lo à toa deixa
# os segredos ilegíveis e desloga todo mundo — para trocar de verdade (vazamento),
# rode a rotação descrita em docs/deployment.md.
APP_SECRET=change-me-please-generate-a-long-random-value

# Senha do Postgres — troque numa instalação real. O banco não é publicado no
# host: a app fala com ele pela rede interna do compose.
POSTGRES_PASSWORD=aiworkspace


# --- Acesso ---------------------------------------------------------------
# O app já sobe em HTTPS: https://<host>/ serve o front e https://<host>/api a
# API, na MESMA origem. Por localhost, IP da LAN ou da VPN não é preciso
# preencher nada — o certificado é emitido sob demanda (docs/https.md).
#
# Tem DOMÍNIO público? Descomente os três (isto liga o Let's Encrypt):
#CADDY_SITE=app.seudominio.com
#CADDY_MODE=public
#WEB_ORIGIN=https://app.seudominio.com
# ...e ajuste os redirect_uri das integrações OAuth (docs/integration-auth.md).

# Portas 80/443 já ocupadas no host? (ex.: 8443 → https://SEU_IP:8443)
#HTTPS_PORT=443
#HTTP_PORT=80


# --- Serviços opt-in (só sobem com --profile) -----------------------------
# Chave compartilhada entre o server e o serviço; gere com
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# WhatsApp por QR Code — docker compose --profile whatsapp up -d
#EVOLUTION_API_KEY=
# Navegador headless  — docker compose --profile browser up -d
#BROWSER_TOKEN=


# Todas as outras variáveis, com seus defaults: docs/configuration.md
